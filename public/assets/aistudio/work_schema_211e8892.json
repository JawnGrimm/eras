{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scribe-of-eras:work-schema:0.1",
  "title": "Scribe of Eras - Work definition",
  "description": "One authored Work. Evidence, action costs, stage completion, validator outcomes and consequences are all derived from this single file so the GDD tables cannot drift from the data.",
  "type": "object",
  "required": [
    "schema_version", "work_id", "title", "era", "gdd_version", "config", "roles",
    "state", "evidence", "actions", "stages", "register_designs", "tests",
    "invariants", "responsibility_questions", "outcomes", "adoption",
    "provisions", "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "work_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "era": { "enum": ["I", "II", "III", "IV", "V", "VI", "VII"] },
    "gdd_version": { "type": "string" },

    "config": {
      "type": "object",
      "required": ["ap_per_day", "costs_shown_before_commit", "hidden_costs_allowed"],
      "additionalProperties": false,
      "properties": {
        "ap_per_day": { "type": "integer", "minimum": 1 },
        "costs_shown_before_commit": { "const": true },
        "hidden_costs_allowed": { "const": false }
      }
    },

    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "interest", "required_interaction"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "interest": { "type": "string" },
          "required_interaction": { "type": "string" }
        }
      }
    },

    "state": {
      "type": "object",
      "required": ["quantities", "timeline"],
      "additionalProperties": false,
      "properties": {
        "quantities": {
          "description": "Authored once. Every number the player can see or be tested on is derived from here.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "timeline": {
          "description": "Order of authored events. order=null means the sequence is not yet decided; the validator warns about it.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "order"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "order": { "type": ["integer", "null"], "minimum": 1 },
              "after": { "type": "array", "items": { "$ref": "#/$defs/id" } },
              "before": { "type": "array", "items": { "$ref": "#/$defs/id" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },

    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "establishes", "reliability", "visible_in_stage", "facts"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "type": "string" },
          "establishes": { "type": "string", "description": "Player-facing statement of what this source proves, and what it does not." },
          "reliability": { "enum": ["primary_record", "physical_inspection", "testimony", "inference"] },
          "visible_in_stage": { "enum": ["A", "B", "C", "D"] },
          "facts": {
            "description": "Keys of state.quantities this source supports. Empty for sources that only limit what can be claimed.",
            "type": "array", "items": { "type": "string" }
          },
          "limits": { "type": "string", "description": "What the source explicitly does NOT establish." },
          "test_id": { "$ref": "#/$defs/id" }
        }
      }
    },

    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stage", "label", "ap_cost", "grants_evidence",
                     "required_for_stage_completion", "required_for_full_adoption"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "stage": { "enum": ["A", "B", "C", "D"] },
          "label": { "type": "string" },
          "ap_cost": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              {
                "type": "object", "required": ["from_register_setup"], "additionalProperties": false,
                "properties": { "from_register_setup": { "const": true } }
              }
            ]
          },
          "roles": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "grants_evidence": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "required_for_stage_completion": { "type": "boolean" },
          "required_for_full_adoption": { "type": "boolean" },
          "repeatable": { "type": "boolean", "default": false },
          "max_uses": { "type": ["integer", "null"], "minimum": 1 },
          "gate": { "type": ["string", "null"], "description": "Condition that unlocks a repeat, e.g. failed_test." },
          "test_id": { "$ref": "#/$defs/id" },
          "source_status": { "$ref": "#/$defs/source_status" },
          "notes": { "type": "string" }
        }
      }
    },

    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "objective", "completion", "deliverable"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["A", "B", "C", "D"] },
          "name": { "type": "string" },
          "objective": { "type": "string" },
          "deliverable": { "type": "string" },
          "completion": {
            "type": "object",
            "required": ["actions_all_of"],
            "additionalProperties": false,
            "properties": {
              "evidence_all_of": { "type": "array", "items": { "$ref": "#/$defs/id" } },
              "actions_all_of": { "type": "array", "items": { "$ref": "#/$defs/id" } }
            }
          }
        }
      }
    },

    "register_designs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "setup_ap", "test_support", "ongoing_per_entry_ap"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "setup_ap": { "type": "integer", "minimum": 0 },
          "ongoing_per_entry_ap": {
            "type": ["integer", "null"], "minimum": 0,
            "description": "AP added to each later entry/dossier. null = not yet designed (validator warns)."
          },
          "strength": { "type": "string" },
          "limitation": { "type": "string" },
          "test_support": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["test_id", "support"],
              "additionalProperties": false,
              "properties": {
                "test_id": { "$ref": "#/$defs/id" },
                "support": { "enum": ["native", "needs_supplement", "fails"] },
                "extra_ap": { "type": ["integer", "null"], "minimum": 0 },
                "source_status": { "$ref": "#/$defs/source_status" }
              }
            }
          }
        }
      }
    },

    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "evidence", "required_for_adoption", "expected", "must_not"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "capability": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "required_for_adoption": { "type": "boolean" },
          "expected": { "type": "object", "additionalProperties": { "type": ["integer", "string"] } },
          "must_not": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "invariants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["arithmetic", "identity", "attribution"] },
          "description": { "type": "string" },
          "lhs": { "type": "string", "description": "Arithmetic expression over state.quantities (+, -, *)." },
          "op": { "enum": ["==", "<=", ">="] },
          "rhs": { "type": "string" }
        },
        "if": { "properties": { "kind": { "const": "arithmetic" } } },
        "then": { "required": ["lhs", "op", "rhs"] }
      }
    },

    "responsibility_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "answer", "supported_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string" },
          "answer": { "type": "string", "description": "'unestablished' or the id of the role the evidence actually supports." },
          "supported_by": { "type": "array", "items": { "$ref": "#/$defs/id" } }
        }
      }
    },

    "outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict", "description", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "verdict": { "enum": ["accepted", "incorrect"] },
          "error_class": {
            "enum": ["arithmetic_error", "factual_misclassification", "unsupported_attribution",
                     "missing_provenance", "invalid_state_transition", "incomplete_procedure"]
          },
          "severity": { "enum": ["core", "noncritical"] },
          "description": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "correction_path": { "type": "string" }
        },
        "if": { "properties": { "verdict": { "const": "incorrect" } } },
        "then": { "required": ["error_class", "severity", "correction_path"] }
      }
    },

    "adoption": {
      "type": "object",
      "required": ["tests_required", "provisional_allowed_for", "rejected_when", "soft_lock_allowed"],
      "additionalProperties": false,
      "properties": {
        "tests_required": { "enum": ["all", "any"] },
        "provisional_allowed_for": { "const": "noncritical" },
        "rejected_when": { "const": "core" },
        "soft_lock_allowed": { "const": false }
      }
    },

    "provisions": {
      "type": "object",
      "required": ["resource", "quantity", "per", "min_ap_on_work", "ends_on", "max_provisioned_days"],
      "additionalProperties": false,
      "properties": {
        "resource": { "enum": ["bread"] },
        "quantity": { "type": "integer", "minimum": 1 },
        "per": { "const": "active_work_day" },
        "min_ap_on_work": { "type": "integer", "minimum": 1 },
        "ends_on": { "type": "array", "items": { "enum": ["completed", "abandoned", "suspended"] } },
        "max_provisioned_days": { "type": ["integer", "null"], "minimum": 1 }
      }
    },

    "consequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "effect"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "trigger": { "type": "string" },
          "effect": { "type": "string" },
          "numbers_status": { "enum": ["unassigned", "proposed", "tuned"] }
        }
      }
    },

    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "historical_xp": { "type": ["integer", "null"] },
        "career_xp": { "type": ["integer", "null"] },
        "rule": { "type": "string" }
      }
    },

    "targets": {
      "type": "object",
      "required": ["expected_days_min", "expected_days_max"],
      "additionalProperties": false,
      "properties": {
        "expected_days_min": { "type": "integer", "minimum": 1 },
        "expected_days_max": { "type": "integer", "minimum": 1 }
      }
    },

    "reconciliation_notes": {
      "description": "Where this data resolves an inconsistency in the GDD prose. Confirm each with the designer, then fix the GDD.",
      "type": "array", "items": { "type": "string" }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "source_status": {
      "enum": ["gdd", "proposed"],
      "description": "gdd = stated in the GDD; proposed = added by design review and needs a decision."
    }
  }
}
